# Core runtime
MONGO_URI=mongodb://localhost:27017/
APP_DB_NAME=product_search

# Collections
RAW_COLLECTION=offers_raw
NORMALIZED_COLLECTION=offers_normalized
CANONICAL_COLLECTION=canonical_products
PRICE_HISTORY_COLLECTION=price_history
MATCH_PAIRS_COLLECTION=match_pairs_labeled
INTERACTIONS_COLLECTION=user_interactions
AUDIT_COLLECTION=api_audit_logs

# LLM (Groq)
GROQ_API_KEY=replace-with-your-groq-key
LLM_ENABLED=true
LLM_MODEL=groq/compound-mini
ASSISTANT_MODEL=groq/compound-mini

# Auth and API protection
AUTH_MODE=api_key
SERVICE_API_KEY=replace-with-service-api-key
ADMIN_API_KEY=replace-with-admin-api-key
REQUIRE_AUTH_FOR_WRITE=true
CONVERSATION_REQUIRE_USER_ID=false

# JWT settings (used when AUTH_MODE=jwt)
JWT_SECRET=replace-with-jwt-secret
JWT_ALGORITHM=HS256

# Search/compute guards
MAX_CANDIDATES=300
MAX_CLUSTER_CANDIDATES=200

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Models and operations
MATCHER_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2
MODEL_REGISTRY_DIR=artifacts/registry
SCRAPE_FAIL_ALERT_THRESHOLD=3

# Assistant/runtime
ASSISTANT_MAX_TOOL_CALLS=4
ASSISTANT_MAX_CONTEXT_TURNS=12
ASSISTANT_SUMMARY_TRIGGER_TURNS=24
ASSISTANT_MAX_TOOL_OUTPUT_CHARS=6000
CONVERSATION_TTL_DAYS=30

# Live search and page inspection
LIVE_SEARCH_ENABLED=true
LIVE_SEARCH_MODEL=groq/compound-mini
LIVE_SEARCH_COUNTRY=pakistan
LIVE_SEARCH_MAX_RESULTS=8
LIVE_SEARCH_VERIFY_TOP_N=5
INSPECT_PAGE_ENABLED=true
INSPECT_PAGE_TIMEOUT_SEC=20
INSPECT_PAGE_MAX_REDIRECTS=5
INSPECT_PAGE_MAX_RESPONSE_BYTES=1200000
INSPECT_PAGE_BLOCK_PRIVATE_NETWORKS=true

# Logging
LOG_LEVEL=INFO
